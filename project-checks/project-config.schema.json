{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Project configuration v1",
  "version": "1.0",
  "type": "object",
  "required": [
    "version",
    "configuration"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1.0
      ]
    },
    "configuration": {
      "type": "object",
      "required": [
        "has_webserver",
        "readonly_paths",
        "ide_config"
      ],
      "additionalProperties": false,
      "properties": {
        "has_webserver": {
          "type": "boolean"
        },
        "scoring": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max_score": {
              "type": "number"
            },
            "timeout": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "readonly_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ide_config": {
          "type": "object",
          "required": [
            "default_open_files",
            "project_menu"
          ],
          "properties": {
            "default_open_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "project_menu": {
              "type": "object",
              "properties": {
                "run": {
                  "type": "string",
                  "minLength": 1
                },
                "install": {
                  "type": "string",
                  "minLength": 1
                },
                "test": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "run",
                "install"
              ]
            },
            "ports_settings": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "name",
                  "hidePreview"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "hidePreview": {
                    "type": "boolean"
                  },
                  "primary": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "type": {
      "type": "string",
      "description": "Optional project type metadata; it does not change command selection."
    }
  }
}
